    var canvas = document.getElementById('starfield');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var stars = [];
    var w = 0, h = 0;
    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resize() {
      var dpr = window.devicePixelRatio || 1;
      var rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      var count = Math.min(200, Math.floor((w * h) / 8000));
      stars = [];
      for (var i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: Math.random() * 1.2 + 0.3,
          a: Math.random() * 0.6 + 0.2,
          twinkle: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.3 + 0.1
        });
      }
    }

    var rafId = null;
    var lastT = 0;
    function draw(t) {
      if (prefersReduced) {
        ctx.clearRect(0, 0, w, h);
        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];
          ctx.fillStyle = 'rgba(232, 232, 237, ' + s.a + ')';
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fill();
        }
        return;
      }
      var dt = Math.min(50, t - lastT) / 16;
      lastT = t;
      ctx.clearRect(0, 0, w, h);
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.twinkle += 0.02 * dt * s.speed;
        var alpha = s.a * (0.5 + 0.5 * Math.sin(s.twinkle));
        ctx.fillStyle = 'rgba(232, 232, 237, ' + alpha.toFixed(3) + ')';
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
      rafId = requestAnimationFrame(draw);
    }

    resize();
    if (!prefersReduced) rafId = requestAnimationFrame(draw);
    else draw(0);
    window.addEventListener('resize', function() {
      resize();
      if (prefersReduced) draw(0);
    });

    // ===== COUNT UP =====
    function countUp(el) {
      var target = parseFloat(el.getAttribute('data-count'));
      var decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
      if (isNaN(target)) return;
      var duration = 1600;
      var start = performance.now();
      function step(now) {
        var p = Math.min(1, (now - start) / duration);
        var eased = 1 - Math.pow(1 - p, 3);
        var v = target * eased;
        el.textContent = decimals > 0 ? v.toFixed(decimals) : Math.round(v).toString();
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = decimals > 0 ? target.toFixed(decimals) : target.toString();
      }
      requestAnimationFrame(step);
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          countUp(e.target);
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('[data-count]').forEach(function(el) {
      observer.observe(el);
    });

    // ===== SMOOTH SCROLL =====
    document.querySelectorAll('a[href^="#"]').forEach(function(a) {
      a.addEventListener('click', function(ev) {
        var href = a.getAttribute('href');
        if (href === '#' || href.length < 2) return;
        var target = document.querySelector(href);
        if (!target) return;
        ev.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // ===== PREDICTIONS HUB =====
    var DOMAIN_COLOR = {
      'ai':'#3B82F6','demographics':'#8B5CF6','energy':'#10B981',
      'cross-domain':'#F59E0B','space':'#6366F1','space-alien':'#EC4899',
      'space-economy':'#14B8A6','biotech':'#EF4444','quantum':'#A78BFA',
      'climate':'#06B6D4'
    };
    var DOMAIN_ICON = {
      'ai':'🤖','demographics':'👥','energy':'⚡','cross-domain':'🔗',
      'space':'🚀','space-alien':'👽','space-economy':'🛰️','biotech':'🧬',
      'quantum':'⚛️','climate':'🌡️'
    };
    var DOMAINS_ORDER = ['ai','demographics','energy','cross-domain','space','space-economy','biotech','quantum','climate','space-alien'];

    var state = {
      domain: 'all',
      conf: 'all',
      sort: 'e'
    };

    function confLevel(o) {
      if (o >= 65) return 'high';
      if (o >= 40) return 'med';
      return 'low';
    }
    function scoreLevel(e) {
      if (e >= 70) return 'high';
      if (e >= 40) return 'med';
      return 'low';
    }

    // Build domain filter buttons
    var domainCounts = {};
    PREDICTIONS.forEach(function(p) {
      domainCounts[p.d] = (domainCounts[p.d] || 0) + 1;
    });
    var domainsEl = document.getElementById('ph-domains');
    if (domainsEl) {
      var allBtn = document.createElement('button');
      allBtn.className = 'domain-btn active';
      allBtn.setAttribute('data-domain', 'all');
      allBtn.innerHTML = 'All <span class="d-count">' + PREDICTIONS.length + '</span>';
      domainsEl.appendChild(allBtn);
      DOMAINS_ORDER.forEach(function(d) {
        if (!domainCounts[d]) return;
        var b = document.createElement('button');
        b.className = 'domain-btn';
        b.setAttribute('data-domain', d);
        var icon = DOMAIN_ICON[d] || '';
        b.innerHTML = icon + ' ' + (PREDICTIONS.find(function(p){return p.d===d}) || {dl:d}).dl + ' <span class="d-count">' + domainCounts[d] + '</span>';
        domainsEl.appendChild(b);
      });
      domainsEl.addEventListener('click', function(ev) {
        var t = ev.target.closest('.domain-btn');
        if (!t) return;
        state.domain = t.getAttribute('data-domain');
        domainsEl.querySelectorAll('.domain-btn').forEach(function(x){x.classList.remove('active')});
        t.classList.add('active');
        render();
      });
    }

    // Confidence filter
    var confEl = document.querySelector('.ph-conf');
    if (confEl) {
      confEl.addEventListener('click', function(ev) {
        var t = ev.target.closest('.conf-btn');
        if (!t) return;
        state.conf = t.getAttribute('data-conf');
        confEl.querySelectorAll('.conf-btn').forEach(function(x){x.classList.remove('active')});
        t.classList.add('active');
        render();
      });
    }

    // Sort
    var sortEl = document.getElementById('ph-sort-select');
    if (sortEl) {
      sortEl.addEventListener('change', function() {
        state.sort = sortEl.value;
        render();
      });
    }

    function render() {
      var list = PREDICTIONS.filter(function(p) {
        if (state.domain !== 'all' && p.d !== state.domain) return false;
        if (state.conf !== 'all' && confLevel(p.o) !== state.conf) return false;
        return true;
      });
      list.sort(function(a, b) {
        if (state.sort === 'e') return b.e - a.e;
        if (state.sort === 'o') return b.o - a.o;
        if (state.sort === 'y') return a.y - b.y;
        return a.id.localeCompare(b.id);
      });

      // Stats
      var statsEl = document.getElementById('ph-stats');
      if (statsEl && list.length) {
        var avgE = list.reduce(function(s,p){return s+p.e},0) / list.length;
        var avgO = list.reduce(function(s,p){return s+p.o},0) / list.length;
        var hi = list.filter(function(p){return confLevel(p.o)==='high'}).length;
        statsEl.innerHTML =
          '<span><span class="stat-lbl">Showing</span><span class="stat-val">' + list.length + '</span></span>' +
          '<span><span class="stat-lbl">Avg Engine</span><span class="stat-val">' + avgE.toFixed(1) + '</span></span>' +
          '<span><span class="stat-lbl">Avg Original</span><span class="stat-val">' + avgO.toFixed(0) + '%</span></span>' +
          '<span><span class="stat-lbl">High Conf</span><span class="stat-val">' + hi + '/' + list.length + '</span></span>';
      } else if (statsEl) {
        statsEl.innerHTML = '<span class="stat-lbl">No predictions match filters</span>';
      }

      // Grid
      var gridEl = document.getElementById('ph-grid');
      if (!gridEl) return;
      if (!list.length) {
        gridEl.innerHTML = '<div class="ph-empty">No predictions match current filters.</div>';
        return;
      }
      var html = list.map(function(p) {
        var color = DOMAIN_COLOR[p.d] || '#6366F1';
        var icon = DOMAIN_ICON[p.d] || '•';
        var sl = scoreLevel(p.e);
        var cl = confLevel(p.o);
        return '<article class="p-card" id="' + p.id + '" data-id="' + p.id + '">' +
          '<div class="p-card-head">' +
            '<span class="p-id">' + p.id + '</span>' +
            '<span class="p-domain-tag" style="color:' + color + '"><span>' + icon + '</span> ' + p.dl + '</span>' +
          '</div>' +
          '<h3 class="p-title">' + p.t + '</h3>' +
          '<div class="p-score-row">' +
            '<div class="p-score-bar"><div class="p-score-fill ' + sl + '" style="width:' + Math.min(100, p.e) + '%"></div></div>' +
            '<div class="p-score-nums"><span class="p-score-val">' + p.e.toFixed(1) + '</span><span class="p-score-lbl">engine</span><span class="p-orig">orig ' + p.o + '%</span></div>' +
          '</div>' +
          '<div class="p-foot">' +
            '<span>' + p.v + '</span>' +
            '<span class="p-days">' + (p.y > 0 ? p.y + 'd' : 'past') + '</span>' +
          '</div>' +
        '</article>';
      }).join('');
      gridEl.innerHTML = html;
    }
    render();
  } catch (e) {
    // silent
  }
})();
</script>
</body>
</html>
